# Service
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# Postgres is the source of truth
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable

# Redis is a cache, not a store
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Secrets
API_KEY_PEPPER=local-dev-pepper

# Bootstrap accounts: name:key,name:key (created at startup if missing)
BOOTSTRAP_USERS=local:local-dev-key-change-me

# Behaviour
CACHE_TTL=24h
NEGATIVE_CACHE_TTL=30s
RATE_LIMIT_PER_MINUTE=120
CLICK_BUFFER=2048
SHUTDOWN_TIMEOUT=15s

# Allow redirecting to private/loopback targets. Keep false in production:
# a public shortener that points at internal hosts is an abuse vector.
ALLOW_PRIVATE_TARGETS=true

# Peers allowed to set X-Forwarded-For (your load balancer / ingress ranges).
# Empty means the header is ignored, which is correct when the API is exposed
# directly to the internet.
TRUSTED_PROXY_CIDRS=
